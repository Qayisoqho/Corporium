[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "languages\ChineseSimplified.isl"

[CustomMessages]
english.DesktopShortcut=Create a desktop shortcut
chinesesimplified.DesktopShortcut=创建桌面快捷方式
english.LaunchApp=Launch Corporium
chinesesimplified.LaunchApp=启动 Corporium
english.LicenseTitle=Corporium · Licenses
chinesesimplified.LicenseTitle=Corporium · 许可说明
english.AppLicense=Corporium license
chinesesimplified.AppLicense=Corporium 使用许可
english.RuntimeLicense=Microsoft WebView2 license (full text)
chinesesimplified.RuntimeLicense=Microsoft WebView2 许可全文
english.ThirdParty=Third-party components and privacy
chinesesimplified.ThirdParty=第三方组件与隐私说明
english.Close=Close
chinesesimplified.Close=关闭
english.ReadLicenses=View licenses
chinesesimplified.ReadLicenses=查看许可说明
english.AgreeInstall=Agree and install
chinesesimplified.AgreeInstall=同意并安装
english.AcceptanceNotice=Choosing Agree and install accepts the Corporium and WebView2 licenses.
chinesesimplified.AcceptanceNotice=点击“同意并安装”即表示接受 Corporium 与 WebView2 的许可。
english.RuntimeNotice=The Windows interface uses Microsoft WebView2. The bundled runtime is installed if needed.
chinesesimplified.RuntimeNotice=Windows 桌面界面使用 Microsoft WebView2；缺少时将安装随包运行库。
english.PrivacyNotice=WebView2 includes SmartScreen and sends related information to Microsoft under Microsoft's privacy statement.
chinesesimplified.PrivacyNotice=WebView2 包括 SmartScreen，按微软隐私声明收集并向微软发送相关信息。
english.ReadAfterInstall=Use the button below for full licenses and privacy links. After installation, see Manage → About & licenses.
chinesesimplified.ReadAfterInstall=许可全文及隐私链接可点下方查看，安装后仍可在“管理 → 关于与许可”中阅读。
english.LicenseRequired=Read the licenses and choose Agree and install first.
chinesesimplified.LicenseRequired=请先阅读许可说明，并点击“同意并安装”。
english.LicenseReadError=Could not read license file: %1
chinesesimplified.LicenseReadError=无法读取许可文件：%1
english.LicenseStopped=Installation stopped because the licenses were not accepted.
chinesesimplified.LicenseStopped=未接受许可，安装已停止。
english.SilentLicenseStopped=Licenses not accepted; installation stopped. For silent deployment, read the bundled licenses and explicitly pass /ACCEPTLICENSES=1.
chinesesimplified.SilentLicenseStopped=未接受许可，安装已停止。静默部署须先阅读随包许可，再显式指定 /ACCEPTLICENSES=1。
english.LicenseAcceptedLog=The user chose Agree and install and accepted the Corporium and WebView2 licenses bundled with this release.
chinesesimplified.LicenseAcceptedLog=用户点击“同意并安装”，接受本发行包所附 Corporium 与 WebView2 许可。
english.WebViewStartError=WebView2 installation could not start. Run this installer again.
chinesesimplified.WebViewStartError=无法启动 WebView2 安装。请重新运行本安装程序。
english.WebViewFinishError=WebView2 installation did not complete. Restart Windows and run this installer again. Code: %1
chinesesimplified.WebViewFinishError=WebView2 安装未完成。请重启 Windows 后重新运行本安装程序。代码：%1
